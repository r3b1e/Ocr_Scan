{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [
      "jest"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "../shared/*"
      ],
      "@shared": [
        "../shared/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../shared/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "../shared/__tests__"
  ]
}