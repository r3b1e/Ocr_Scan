# ---- MySQL (required for online mode) -------------------------------------
# The app auto-creates the database and tables on first run.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ocr_user
DB_PASSWORD=change_me
DB_NAME=ocr_scanner

# ---- Camera -----------------------------------------------------------------
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# ---- OCR --------------------------------------------------------------------
# Comma-separated EasyOCR language codes, e.g. "en" or "en,hi"
OCR_LANGUAGES=en
# auto | true | false  (auto = use CUDA if torch reports it, else CPU)
OCR_GPU=auto
# Run live-preview OCR on every Nth camera frame
OCR_EVERY_N_FRAMES=10
# Detections below this confidence are skipped (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.4
# Apply grayscale/denoise/CLAHE before OCR during Scan
PREPROCESS_ENABLED=true
# Optional: directory where EasyOCR stores its models (default ~/.EasyOCR)
# OCR_MODEL_DIR=

# ---- Misc -------------------------------------------------------------------
AUDIO_ENABLED=true
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- remainRX prescription extraction ---------------------------------------
# Which vision backend reads prescriptions: claude (cloud, best accuracy) or ollama (local, free)
EXTRACTOR_BACKEND=claude
# Claude model id used by the claude backend (cheaper: claude-sonnet-5-5, claude-haiku-5-5)
CLAUDE_MODEL=claude-opus-5-5
# Required for the claude backend
ANTHROPIC_API_KEY=
# Local Ollama server and vision model (run: ollama pull qwen2.5vl:3b). Avoid reasoning
# models such as qwen3-vl here: under Ollama's JSON-schema output they think until the token
# budget runs out and return nothing.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
# Uploaded images are downscaled so the longest side is at most this many pixels
EXTRACT_MAX_IMAGE_SIDE=1600
# Send the EasyOCR transcript to the model as a hint for printed prescriptions
OCR_HINT_FOR_PRINTED=true
# Fields below this confidence are highlighted for the user to check
CONFIDENCE_FLAG_THRESHOLD=0.6
# Indian brand/composition lexicon (default data/drug_lexicon_in.csv)
# LEXICON_PATH=
# FastAPI bind address for `python -m service`
API_HOST=127.0.0.1
API_PORT=8000
